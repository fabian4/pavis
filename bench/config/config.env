# Benchmark target parameters (shared defaults)

# Gate thresholds for CI summary aggregation.
GATE_STANDALONE_LATENCY_SHORT_1X_DROPPED_MAX=100 # standalone latency_short_1x dropped should be <= 100.
GATE_STANDALONE_CONCURRENCY_SHORT_1X_ERRORS_EQ=0 # standalone concurrency_short_1x errors should be == 0.
GATE_SYSTEM_CONFIG_RELOAD_CONVERGENCE_MAX_MS=250 # system config_reload_convergence convergence_time_ms should be <= 250.
GATE_SYSTEM_ROLLBACK_TTBR_MAX=10000 # system rollback_performance rollback_ttbr_ms should be <= 10000.
ROLLBACK_TTBR_THRESHOLD_MS=1000 # CI gate threshold for rollback_performance rollback_ttbr_ms.
GATE_SYSTEM_STRESS_RECOVERY_LATENCY_REGRESSION_PCT_MAX=20 # system stress_recovery latency_regression_pct should be <= 20.

# System cases
SYSTEM_CONFIG_RELOAD_CONVERGENCE_TARGET_RPS=1000 # Target RPS for config reload convergence load.
SYSTEM_CONFIG_RELOAD_CONVERGENCE_DURATION_S=60 # Load duration for config reload convergence run (seconds).
SYSTEM_CONFIG_RELOAD_CONVERGENCE_CONVERGENCE_WINDOW_S=10 # Window for transition latency snapshot (seconds).

SYSTEM_ROLLBACK_PERFORMANCE_TARGET_RPS=1000 # Target RPS for rollback performance load.
SYSTEM_ROLLBACK_PERFORMANCE_BASELINE_DURATION_S=30 # Baseline duration before introducing degradation (seconds).
SYSTEM_ROLLBACK_PERFORMANCE_DEGRADED_DURATION_S=10 # Degraded config duration before rollback (seconds).
SYSTEM_ROLLBACK_PERFORMANCE_RECOVERY_DURATION_S=30 # Recovery duration after rollback (seconds).

SYSTEM_STRESS_RECOVERY_BASELINE_RPS=5000 # Baseline RPS for stress recovery test.
SYSTEM_STRESS_RECOVERY_STRESS_RPS=15000 # Stress RPS for saturation phase.
SYSTEM_STRESS_RECOVERY_BASELINE_DURATION_S=30 # Baseline phase duration (seconds).
SYSTEM_STRESS_RECOVERY_STRESS_DURATION_S=60 # Stress phase duration (seconds).
SYSTEM_STRESS_RECOVERY_RECOVERY_DURATION_S=60 # Recovery phase duration (seconds).

SYSTEM_MULTI_HOUR_SOAK_TARGET_RPS=7500 # Soak RPS target (75% capacity).
SYSTEM_MULTI_HOUR_SOAK_DURATION_HOURS=4 # Soak duration in hours.
SYSTEM_MULTI_HOUR_SOAK_SAMPLE_INTERVAL_S=60 # Resource sampling interval during soak (seconds).

# Standalone cases
STANDALONE_THROUGHPUT_SHORT_1X_DURATION_S=30 # Duration for throughput_short_1x (seconds).
STANDALONE_THROUGHPUT_SHORT_1X_CONNECTIONS=100 # Connections for throughput_short_1x.
STANDALONE_THROUGHPUT_SHORT_1X_TARGET_RPS= # Target RPS for throughput_short_1x (empty for max throughput).

STANDALONE_CONCURRENCY_SHORT_1X_DURATION_S=30 # Duration for concurrency_short_1x (seconds).
STANDALONE_CONCURRENCY_SHORT_1X_CONNECTIONS=5000 # Connections for concurrency_short_1x.
STANDALONE_CONCURRENCY_SHORT_1X_TARGET_RPS= # Target RPS for concurrency_short_1x (empty for max throughput).

STANDALONE_CHURN_SHORT_1X_DURATION_S=30 # Duration for churn_short_1x (seconds).
STANDALONE_CHURN_SHORT_1X_CONNECTIONS=100 # Connections for churn_short_1x.
STANDALONE_CHURN_SHORT_1X_TARGET_RPS= # Target RPS for churn_short_1x (empty for max throughput).

STANDALONE_LATENCY_SHORT_1X_DURATION_S=30 # Duration for latency_short_1x (seconds).
STANDALONE_LATENCY_SHORT_1X_CONNECTIONS=500 # Connections for latency_short_1x.
STANDALONE_LATENCY_SHORT_1X_TARGET_RPS=10000 # Target RPS for latency_short_1x.

STANDALONE_LATENCY_EXTENDED_1X_DURATION_S=300 # Duration for latency_extended_1x (seconds).
STANDALONE_LATENCY_EXTENDED_1X_CONNECTIONS=500 # Connections for latency_extended_1x.
STANDALONE_LATENCY_EXTENDED_1X_TARGET_RPS=10000 # Target RPS for latency_extended_1x.
